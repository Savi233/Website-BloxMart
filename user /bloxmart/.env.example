# BloxMart.ID configuration - never commit real secrets
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# PostgreSQL terkelola (Supabase/Neon). Gunakan URL pooled untuk fungsi serverless.
# Gunakan role owner/postgres (bukan anon/read-only) agar skema dapat dibuat otomatis.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Hanya untuk PostgreSQL lokal tanpa TLS; jangan gunakan di production.
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=5

# QiosPay QRIS. Jangan menaruh kredensial ini di NEXT_PUBLIC_ atau client.
PAYMENT_PROVIDER=qiospay
QIOSPAY_BASE_URL=https://my.qiospay.com/v1
QIOSPAY_API_KEY=replace-with-qiospay-server-key
QIOSPAY_PRIVATE_KEY=replace-with-qiospay-private-key
# Alias lama yang masih didukung; gunakan QIOSPAY_PRIVATE_KEY untuk signature.
QIOSPAY_WEBHOOK_SECRET=
# Endpoint resmi QiosPay: POST /v1/invoices. Nilai env ini boleh dibiarkan.
QIOSPAY_CREATE_PAYMENT_PATH=/invoices
